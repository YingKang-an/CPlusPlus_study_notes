{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C++20: g++13 编译",
            "type": "shell",
            "command": "g++-13", // 用G++13编译
            "args": [
                "-std=c++20",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "group": {"kind": "build", "isDefault": true},
            "problemMatcher": ["$gcc"],
            "detail": "G++13编译C++20代码"
        }
    ]
}
